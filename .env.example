OPENAI_API_KEY=<your-openai-api-key>
GOOGLE_CLIENT_ID=<oauth-client-app-id>
GOOGLE_CLIENT_SECRET=<oauth-client-secret>
OAUTH_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Optional: enable Felix's GitHub editing capability through GitHub's remote MCP server.
# Keep the token server-side; never expose it to browser/client code.
GITHUB_MCP_URL="https://api.githubcopilot.com/mcp/"
GITHUB_MCP_TOKEN=<your-github-pat>
GITHUB_MCP_REQUIRE_APPROVAL="true"
# Comma-separated allow-list. Keep this narrow.
GITHUB_MCP_ALLOWED_TOOLS="get_repository,get_file_contents,search_code,list_branches,create_branch,create_or_update_file,create_pull_request"
